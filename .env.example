# --- Clerk (authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Convex (database/backend) ---
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Gemini (AI generation, evaluation, mentoring) ---
# Server-side only. Never expose to the browser.
GEMINI_API_KEY=
# Google renames/retires Gemini model IDs every few months — if you get a
# "model not found" error (surfaced here as a 502 ai_request_failed), check
# https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-flash

# --- Feedback (in-app feedback button -> email, no DB storage) ---
# Resend (https://resend.com) — free tier is enough for feedback volume.
RESEND_API_KEY=
# Must be on a domain verified in your Resend account, or the shared
# onboarding@resend.dev sender for testing (delivery to any inbox works,
# but it's rate-limited and clearly not your own domain).
FEEDBACK_EMAIL_FROM=
# Where feedback emails land — e.g. your own inbox.
FEEDBACK_EMAIL_TO=

# --- SEO ---
# Production URL, no trailing slash. Used for metadataBase, canonical URLs,
# sitemap.xml, robots.txt, and the JSON-LD on the landing page. Set this to
# your real deploy domain before going live — link previews and search
# indexing both depend on it being correct.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: the <meta name="google-site-verification"> content string from
# https://search.google.com/search-console (add the property, choose the
# "HTML tag" verification method, paste just the content value here — not
# the whole tag). Leave blank to skip; you can verify via DNS instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics (PostHog — free tier: 1M events/mo) ---
# https://posthog.com -> New project -> Project settings -> Project API key.
# Leave blank to disable analytics entirely (no script loads, no tracking).
NEXT_PUBLIC_POSTHOG_KEY=
# "https://us.i.posthog.com" (US cloud, default) or "https://eu.i.posthog.com"
# (EU cloud) — use whichever region you picked when creating the project.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
