# dependencies
node_modules/

# next.js
.next/
out/

# convex/_generated is intentionally committed (not ignored) — Convex's own
# CLI refuses to run `codegen` against a deploy key ("Codegen requires an
# existing deployment so doesn't support CONVEX_DEPLOY_KEY. Generate code in
# dev and commit it to the repo instead."), which is exactly what a Vercel
# build authenticates with. `npx convex dev` still regenerates these files
# locally; commit the result after schema/function changes.

# env
.env
.env.local
.env*.local

# misc
.DS_Store
*.log
npm-debug.log*

# claude code (session-local)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
